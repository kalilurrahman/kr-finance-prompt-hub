# ============================================================
# FINPROMPT — optional auth + preference sync (Supabase)
#
# Leave these UNSET and the app runs exactly as before: themes/fonts persist
# to localStorage and no sign-in UI appears.
#
# Set BOTH to turn on "Sign in" + cross-device theme/font sync.
# Copy this file to `.env` (or `.env.local`) and fill in your project values.
# See docs/AUTH-SETUP.md for the full walkthrough.
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
